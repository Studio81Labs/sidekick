{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Studio81Labs/.github:renovate-base"],
  "description": [
    "The Studio81Labs preset owns grouping, release age, action digest pinning,",
    "and Docker digest policy. This file contains only Poker Hero topology.",
    "Python lockfiles are generated by scripts/ci/compile-python-locks.sh and",
    "are excluded from direct edits so hashes never move without the manifest."
  ],
  "ignorePaths": ["apps/backend/requirements-*.txt"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/security-scan\\.yml$/"],
      "matchStrings": [
        "(?<depName>[a-z0-9][\\w.\\-]*(?:/[\\w.\\-]+)+):(?<currentValue>[\\w.\\-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/ci/compile-python-locks\\.sh$/"],
      "matchStrings": [
        "PYTHON_IMAGE=\\\"(?<depName>python):(?<currentValue>[\\w.\\-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/ci/compile-python-locks\\.sh$/"],
      "matchStrings": ["PIP_TOOLS_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "pip-tools",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Keep generated hash locks under the pinned compiler",
      "matchFileNames": ["apps/backend/requirements-*.txt"],
      "enabled": false
    },
    {
      "description": "A Prettier update requires a reviewed repository reformat",
      "matchPackageNames": ["prettier"],
      "groupName": "prettier",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Scope backend and Python dependency updates",
      "matchFileNames": ["apps/backend/**"],
      "semanticCommitScope": "backend",
      "addLabels": ["backend"]
    },
    {
      "description": "Scope PWA dependency updates",
      "matchFileNames": ["apps/pwa/**"],
      "semanticCommitScope": "pwa",
      "addLabels": ["pwa"]
    },
    {
      "description": "Scope OpenAPI contract dependency updates",
      "matchFileNames": ["packages/openapi/**", "packages/openapi-client/**"],
      "semanticCommitScope": "pwa",
      "addLabels": ["pwa"]
    },
    {
      "description": "Scope Rust solver dependency updates",
      "matchFileNames": ["solver-plugins/**"],
      "semanticCommitScope": "solver",
      "addLabels": ["solver"]
    }
  ]
}
