POKER_DATA_DIR=/app/data
# Set to staging or production in the matching Coolify application.
POKER_DEPLOYMENT_ENVIRONMENT=staging
# Stable identity enrolled once on the mounted production data volume.
# POKER_DATA_VOLUME_ID=replace-with-openssl-rand-hex-32
# Optional dedicated mount for scheduled application backups.
# POKER_BACKUP_DIR=/app/backups
POKER_PARSER_PROVIDER=ocr_cv
POKER_PARSER_LAYOUT_PROFILE=fortuna_nations
# JSON lists of additional installed parsers and layout IDs per screenshot.
# Add "auto" only with POKER_EXTERNAL_PARSER_URL; it tries local OCR for explicit
# calibrated client layouts and otherwise routes to external vision.
# Example external profile: ["pokerstars"]. ocr_cv remains limited to its
# calibrated Fortuna/Nations profiles.
POKER_PARSER_ENABLED_PROVIDERS=[]
POKER_PARSER_ENABLED_LAYOUT_PROFILES=[]
POKER_EXTERNAL_PARSER_URL=
POKER_EXTERNAL_PARSER_BEARER_TOKEN=
POKER_EXTERNAL_REQUEST_TIMEOUT_SECONDS=60
POKER_MAX_UPLOAD_BYTES=10485760
POKER_MAX_DATASET_UPLOAD_BYTES=104857600
POKER_MAX_BACKUP_UPLOAD_BYTES=104857600
POKER_DATA_LOCK_EXPORT_TIMEOUT_SECONDS=30
POKER_API_RATE_LIMIT_ENABLED=true
POKER_API_RATE_LIMIT_UPLOADS_PER_MINUTE=120
POKER_API_RATE_LIMIT_BENCHMARKS_PER_MINUTE=6
POKER_API_RATE_LIMIT_DATA_TRANSFERS_PER_MINUTE=6

# Optional but recommended for deployed Workers. Use the same random value as
# the Cloudflare API_PROXY_SECRET secret (minimum 32 characters).
POKER_PROXY_SHARED_SECRET=

# Administrative OCR test mode (ADR 0046). Screenshot upload and live capture are
# not a player data path; enable only for parser testing with a dedicated token
# of at least 32 characters that differs from POKER_PROXY_SHARED_SECRET.
POKER_ADMIN_OCR_TEST_ENABLED=false
POKER_ADMIN_OCR_TEST_TOKEN=

# Hosted developer MCP (disabled by default). Configure the exact public HTTPS
# /mcp URL before enabling. It exposes read-only environment status.
POKER_MCP_ENABLED=false
# POKER_MCP_PUBLIC_URL=https://poker-staging.example.com/mcp
POKER_MCP_ALLOWED_ORIGINS=[]
POKER_MCP_READ_CALLS_PER_MINUTE=60

# Optional privacy-scrubbed unhandled exception reporting.
POKER_SENTRY_DSN=
# Set to staging or production in the matching Coolify application.
POKER_SENTRY_ENVIRONMENT=staging
POKER_SENTRY_RELEASE=
POKER_SENTRY_ERROR_SAMPLE_RATE=1

# Replace with the exact Cloudflare Worker URL or custom PWA domain.
# Example: ["https://poker-trainer.example.com"]
POKER_CORS_ORIGINS=["https://your-pwa-domain.example.com"]
