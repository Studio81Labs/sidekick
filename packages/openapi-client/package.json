{
  "name": "@poker-hero/openapi-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript contract for the Poker Hero backend",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../openapi/openapi.json -o src/generated/openapi.ts && prettier --write --ignore-unknown src/generated/openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "~3.8.1",
    "typescript": "^5.5.0"
  }
}
