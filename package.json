{
  "name": "poker-hero",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "description": "Post-hand Texas Hold'em screenshot training analyzer",
  "author": {
    "name": "Studio81 Labs s.r.o.",
    "email": "dev@studio81.cz",
    "url": "https://www.studio81.cz"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "prepare": "husky",
    "backend:dev": "cd apps/backend && PATH=\"$(pwd)/../../solver-plugins/postflop/target/release:$PATH\" .venv/bin/python -m uvicorn app.main:app --reload --host localhost --port 8000",
    "backend:start": "cd apps/backend && PATH=\"$(pwd)/../../solver-plugins/postflop/target/release:$PATH\" .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "backend:mcp": "cd apps/backend && .venv/bin/python -m app.mcp_gateway",
    "backend:benchmark": "export POKER_BENCHMARK_BASE_DIR=\"$PWD\" && cd apps/backend && .venv/bin/python -m app.dataset_benchmark",
    "backend:recommendation-benchmark": "export POKER_BENCHMARK_BASE_DIR=\"$PWD\" && cd apps/backend && PATH=\"$(pwd)/../../solver-plugins/postflop/target/release:$PATH\" .venv/bin/python -m app.recommendation_benchmark",
    "backend:backup": "cd apps/backend && .venv/bin/python -m app.backup_cli",
    "backend:test": "cd apps/backend && .venv/bin/python -m pytest",
    "api:generate": "cd apps/backend && if test -x .venv/bin/python; then .venv/bin/python ../../scripts/export_openapi.py; else python ../../scripts/export_openapi.py; fi && cd ../.. && pnpm exec openapi-typescript apps/pwa/src/shared/api/generated/openapi.json -o apps/pwa/src/shared/api/generated/openapi.ts && pnpm exec prettier --write --ignore-unknown apps/pwa/src/shared/api/generated/openapi.json apps/pwa/src/shared/api/generated/openapi.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- apps/pwa/src/shared/api/generated",
    "pwa:dev": "pnpm -C apps/pwa dev",
    "pwa:build": "pnpm -C apps/pwa build",
    "pwa:performance": "pnpm pwa:build && node scripts/check-pwa-bundle.mjs",
    "pwa:test": "pnpm -C apps/pwa test",
    "pwa:test:watch": "pnpm -C apps/pwa test:watch",
    "pwa:test:e2e": "pnpm -C apps/pwa test:e2e",
    "frontend:dev": "pnpm pwa:dev",
    "frontend:build": "pnpm pwa:build",
    "frontend:performance": "pnpm pwa:performance",
    "frontend:test": "pnpm pwa:test",
    "frontend:test:watch": "pnpm pwa:test:watch",
    "monitor:test": "node --test scripts/check-deployment.test.mjs scripts/check-deployment-mcp.test.mjs",
    "test:e2e": "pnpm pwa:test:e2e",
    "docker:up": "docker compose -f infra/docker/compose.yaml up --build",
    "docker:down": "docker compose -f infra/docker/compose.yaml down"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "7.13.0",
    "prettier": "~3.8.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
