POKER_DATA_DIR=data
POKER_DEPLOYMENT_ENVIRONMENT=local
POKER_PARSER_PROVIDER=ocr_cv
POKER_PARSER_LAYOUT_PROFILE=fortuna_nations
# JSON lists of additional parsers and layout IDs exposed per screenshot.
# Add "auto" only when POKER_EXTERNAL_PARSER_URL is configured; automatic
# recognition tries local OCR for explicit calibrated client layouts and
# otherwise uses external vision.
# Custom layouts such as "pokerstars" are routed to multi-layout parsers;
# fixed-region ocr_cv is offered only for its calibrated profiles.
POKER_PARSER_ENABLED_PROVIDERS=[]
POKER_PARSER_ENABLED_LAYOUT_PROFILES=[]
POKER_PARSER_AUTO_APPROVE_ENABLED=false
POKER_PARSER_AUTO_APPROVE_THRESHOLDS={"hero_cards":0.98,"board_cards":0.98,"pot_size":0.95,"street":0.99}
POKER_RECOMMENDATION_PROVIDER=local_solver
POKER_EXTERNAL_PARSER_URL=
POKER_EXTERNAL_PARSER_BEARER_TOKEN=
POKER_EXTERNAL_PROVIDER_URL=
POKER_EXTERNAL_PROVIDER_BEARER_TOKEN=
POKER_LLM_ADVICE_URL=
POKER_LLM_ADVICE_BEARER_TOKEN=
POKER_EXTERNAL_REQUEST_TIMEOUT_SECONDS=60
POKER_LOCAL_SOLVER_COMMAND=
POKER_LOCAL_SOLVER_ENGINE=postflop_solver
POKER_LOCAL_SOLVER_TIMEOUT_SECONDS=120
POKER_POSTFLOP_SOLVER_COMMAND=poker-postflop-solver
POKER_POSTFLOP_SOLVER_FALLBACK_ENABLED=true
POKER_POSTFLOP_SOLVER_MAX_ITERATIONS=400
POKER_POSTFLOP_SOLVER_TARGET_EXPLOITABILITY=0.01
POKER_POSTFLOP_SOLVER_MAX_MEMORY_MB=768
POKER_POSTFLOP_SOLVER_BET_SIZES=70%
POKER_POSTFLOP_SOLVER_RAISE_SIZES=2.5x
POKER_POSTFLOP_SOLVER_RAKE_RATE=0
POKER_POSTFLOP_SOLVER_RAKE_CAP=0
POKER_POSTFLOP_SOLVER_RANGE_MODE=contextual
POKER_POSTFLOP_SOLVER_OOP_RANGE=66+,A8s+,A5s-A4s,AJo+,K9s+,KQo,QTs+,JTs,96s+,85s+,75s+,65s,54s
POKER_POSTFLOP_SOLVER_IP_RANGE=QQ-22,AQs-A2s,ATo+,K5s+,KJo+,Q8s+,J8s+,T7s+,96s+,86s+,75s+,64s+,53s+
POKER_MAX_UPLOAD_BYTES=10485760
POKER_MAX_DATASET_UPLOAD_BYTES=104857600
POKER_MAX_BACKUP_UPLOAD_BYTES=104857600
POKER_DATA_LOCK_EXPORT_TIMEOUT_SECONDS=30
POKER_API_RATE_LIMIT_ENABLED=true
POKER_API_RATE_LIMIT_UPLOADS_PER_MINUTE=120
POKER_API_RATE_LIMIT_BENCHMARKS_PER_MINUTE=6
POKER_API_RATE_LIMIT_DATA_TRANSFERS_PER_MINUTE=6
POKER_CORS_ORIGINS=["http://localhost:5173"]
POKER_PROXY_SHARED_SECRET=
# Administrative OCR test mode (ADR 0046). Screenshot upload and live capture are
# not a player data path; enable only for parser testing with a dedicated token
# of at least 32 characters that differs from POKER_PROXY_SHARED_SECRET.
POKER_ADMIN_OCR_TEST_ENABLED=false
POKER_ADMIN_OCR_TEST_TOKEN=
POKER_MCP_ENABLED=false
POKER_MCP_PUBLIC_URL=
POKER_MCP_ALLOWED_ORIGINS=[]
POKER_MCP_ALLOW_WRITES=false
POKER_MCP_READ_CALLS_PER_MINUTE=60
POKER_MCP_WRITE_CALLS_PER_MINUTE=10
POKER_SENTRY_DSN=
POKER_SENTRY_ENVIRONMENT=local
POKER_SENTRY_RELEASE=
POKER_SENTRY_ERROR_SAMPLE_RATE=1
