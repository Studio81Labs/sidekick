# Required fixed target. Use a separate process/configuration for each environment.
POKER_MCP_ENVIRONMENT=staging
POKER_MCP_API_BASE_URL=https://poker-staging.example.com

POKER_MCP_REQUEST_TIMEOUT_SECONDS=130

# Preferred when the public Worker is protected by Cloudflare Access.
POKER_MCP_CF_ACCESS_CLIENT_ID=
POKER_MCP_CF_ACCESS_CLIENT_SECRET=
