{
  "name": "@poker-hero/pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && pnpm build:hosted && pnpm build:player:assets",
    "build:hosted": "vite build && node scripts/verify-pwa-build.mjs",
    "build:player": "tsc -b && pnpm build:player:assets",
    "build:player:assets": "vite build --config vite.player.config.ts && node scripts/verify-player-pwa-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium && playwright test --project=mobile-chromium",
    "test:e2e:player-boundary": "pnpm build && playwright test --config=playwright.player.config.ts"
  },
  "dependencies": {
    "@poker-hero/openapi-client": "workspace:*",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "postcss-value-parser": "^4.2.0",
    "tinyglobby": "^0.2.17",
    "typescript": "^5.5.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
